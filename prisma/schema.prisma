datasource db {
  provider = "postgresql"

}

generator client {
  provider = "prisma-client-node"
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String?
  createdAt    DateTime      @default(now())
  appointments Appointment[]
}

model Appointment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  dateTime  DateTime
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}